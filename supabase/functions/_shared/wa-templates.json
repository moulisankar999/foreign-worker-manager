{
 "version": 1,
 "note": "WhatsApp Cloud API message templates (category UTILITY). Submit from Settings > Notifications > WhatsApp templates, or with scripts/wa-templates.mjs. __APP_URL__ is replaced by the app URL. The 'fwm' key is app metadata and is not sent to Meta.",
 "templates": [
  {
   "name": "fwm_request_submitted",
   "language": "en",
   "category": "UTILITY",
   "components": [
    {
     "type": "BODY",
     "text": "New {{1}} request {{2}} for worker {{3}} ({{4}}) is waiting for your review in FW Manager.",
     "example": {
      "body_text": [
       [
        "Annual leave",
        "R-1042",
        "FW0001",
        "Outlet KLCC"
       ]
      ]
     }
    },
    {
     "type": "BUTTONS",
     "buttons": [
      {
       "type": "URL",
       "text": "Open FW Manager",
       "url": "__APP_URL__?go={{1}}",
       "example": [
        "__APP_URL__?go=requests/8f2c1d"
       ]
      }
     ]
    }
   ],
   "fwm": {
    "params": [
     "type",
     "ref",
     "workerNo",
     "outlet"
    ],
    "button": true,
    "note": "request submitted / resubmitted"
   }
  },
