{
  "name": "foreign-worker-manager",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:native": "tsc -b && vite build --mode native",
    "cap:sync": "npm run build:native && npx cap sync",
    "android:apk": "npm run cap:sync && bash scripts/build-android.sh",
    "dev:worker": "vite --config vite.worker.config.ts",
    "build:worker": "tsc -b && vite build --config vite.worker.config.ts",
    "build:worker:native": "tsc -b && vite build --config vite.worker.config.ts --mode native",
    "worker:cap:sync": "npm run build:worker:native && cd worker && npx cap sync",
    "worker:android:apk": "npm run worker:cap:sync && bash scripts/build-android-worker.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "html-to-image": "^1.11.13",
    "libphonenumber-js": "^1.13.15",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.8",
    "vite": "^8.3.5"
  }
}
